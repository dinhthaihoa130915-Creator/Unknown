-- Logic WallHop
local canJump = true
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getNearestWall()
	local character = LocalPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end

	rayParams.FilterDescendantsInstances = {character}

	local directions = {
		rootPart.CFrame.LookVector,
		-rootPart.CFrame.LookVector,
		rootPart.CFrame.RightVector,
		-rootPart.CFrame.RightVector
	}

	local maxDistance = 2
	local closestHit = nil
	local closestDistance = maxDistance + 1

	for _, dir in ipairs(directions) do
		local result = Workspace:Raycast(rootPart.Position, dir * maxDistance, rayParams)
		if result and result.Instance and result.Distance < closestDistance then
			closestDistance = result.Distance
			closestHit = result
		end
	end

	return closestHit
end

local function safeHorizontalUnit(vec, fallback)
	local flat = Vector3.new(vec.X, 0, vec.Z)
	if flat.Magnitude < 0.05 then
		return fallback
	end
	return flat.Unit
end

trackConnection(UserInputService.JumpRequest:Connect(function()
	if _G._WallHopV2Session ~= currentSession then return end
	if not _G._WallHopV2Enabled or not canJump then
		return
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	if not (humanoid and rootPart and camera) then
		return
	end

	local wallHit = getNearestWall()
	if not wallHit then
		return
	end

	canJump = false

	local fallbackDir = safeHorizontalUnit(rootPart.CFrame.LookVector, Vector3.new(0, 0, -1))
	local wallNormalFlat = safeHorizontalUnit(wallHit.Normal, fallbackDir)
	local camLookFlat = safeHorizontalUnit(camera.CFrame.LookVector, wallNormalFlat)

	local cross = wallNormalFlat:Cross(camLookFlat)
	local turnSign = math.sign(cross.Y)
	if turnSign == 0 then
		turnSign = 1
	end

	local targetLook = CFrame.Angles(0, math.rad(45) * turnSign, 0) * wallNormalFlat
	rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + targetLook)

	RunService.Heartbeat:Wait()

	if _G._WallHopV2Session == currentSession and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local pushDir = -wallNormalFlat
		rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + pushDir)
	end

	task.wait(0.15)
	canJump = true
end))