local function setWallHopState(enabled, instant)
	_G._WallHopV2Enabled = enabled
	ToggleLabel.Text = enabled and "WallHop: ON" or "WallHop: OFF"

	local targetColor = enabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
	local targetPos = enabled and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)

